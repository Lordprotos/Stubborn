{% extends 'base.html.twig' %}

{% block title %}Commande confirmée - Stubborn{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div style="font-size: 3rem; color: var(--secondary-color); margin-bottom: 20px;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    
                    <h2 class="card-title">Commande confirmée!</h2>
                    <p class="text-muted mb-4">Merci pour votre achat</p>
                    
                    <div class="alert alert-success">
                        <strong>Montant:</strong> {{ total|number_format(2, ',', ' ') }} €<br>
                        <strong>Status:</strong> Commande validee
                    </div>
                    
                    <p class="mt-4 text-muted">
                        Un email de confirmation a ete envoye
                    </p>
                    
                    <a href="{{ path('app_home') }}" class="btn btn-primary-custom btn-lg mt-4">
                        Retour a l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
