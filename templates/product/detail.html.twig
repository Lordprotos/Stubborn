{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Stubborn{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="{{ asset('assets/images/products/' ~ product.imageName) }}" 
                 alt="{{ product.name }}" class="img-fluid rounded shadow-sm">
        </div>
        
        <div class="col-md-6">
            <h1>{{ product.name }}</h1>
            <p class="text-muted">{{ product.description }}</p>
            
            <h3 style="color: var(--secondary-color);">{{ product.price|number_format(2, ',', ' ') }} €</h3>
            
            <hr>
            
            <!-- Formulaire d'ajout au panier -->
            <form method="post" action="{{ path('app_cart_add', {'productId': product.id}) }}">
                <div class="mb-3">
                    <label for="size" class="form-label">Taille</label>
                    <select id="size" name="size" class="form-select" required>
                        <option value="">-- Sélectionnez une taille --</option>
                        <option value="XS">XS</option>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="quantity" class="form-label">Quantité</label>
                    <input type="number" id="quantity" name="quantity" class="form-control" value="1" min="1">
                </div>
                
                <button type="submit" class="btn btn-primary-custom btn-lg w-100">
                    <i class="fas fa-shopping-cart me-2"></i> Ajouter au panier
                </button>
            </form>
            
            <hr>
            
            <!-- Lien retour -->
            <a href="{{ path('app_products') }}" class="btn btn-outline-secondary w-100">
                Retour aux produits
            </a>
        </div>
    </div>
</div>
{% endblock %}
