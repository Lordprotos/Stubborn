{% extends 'base.html.twig' %}

{% block title %}Panier - Stubborn{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Mon Panier</h1>
        </div>
    </div>
    
    {% if cart|length > 0 %}
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead style="background-color: var(--light-color);">
                                <tr>
                                    <th>Produit</th>
                                    <th>Taille</th>
                                    <th>Quantité</th>
                                    <th>Prix unitaire</th>
                                    <th>Sous-total</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set total = 0 %}
                                {% for key, item in cart %}
                                    {% set subtotal = item.price * item.quantity %}
                                    {% set total = total + subtotal %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="{{ asset('assets/images/products/' ~ item.product.imageName) }}" 
                                                     alt="{{ item.product.name }}" 
                                                     style="width: 50px; height: 50px; object-fit: cover; margin-right: 10px; border-radius: 4px;">
                                                <strong>{{ item.product.name }}</strong>
                                            </div>
                                        </td>
                                        <td>{{ item.size }}</td>
                                        <td>
                                            <input type="number" class="form-control" style="width: 60px;" 
                                                   value="{{ item.quantity }}" min="1" disabled>
                                        </td>
                                        <td>{{ item.price|number_format(2, ',', ' ') }} €</td>
                                        <td><strong>{{ subtotal|number_format(2, ',', ' ') }} €</strong></td>
                                        <td>
                                            <form method="post" action="{{ path('app_cart_remove', {'key': key}) }}" style="display: inline;">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-body">
                        <h5 class="card-title">Résumé de commande</h5>
                        
                        <hr>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total:</span>
                            <strong>{{ total|number_format(2, ',', ' ') }} €</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Frais de port:</span>
                            <strong>Gratuit</strong>
                        </div>
                        
                        <hr>
                        
                        <div class="d-flex justify-content-between mb-4">
                            <h5>Total:</h5>
                            <h5 style="color: var(--secondary-color);">{{ total|number_format(2, ',', ' ') }} €</h5>
                        </div>
                        
                        <a href="{{ path('app_checkout') }}" class="btn btn-primary-custom w-100 mb-3">
                            <i class="fas fa-credit-card me-2"></i> Finaliser ma commande
                        </a>
                        
                        <a href="{{ path('app_products') }}" class="btn btn-outline-secondary w-100">
                            Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <h4 class="alert-heading">Panier vide</h4>
            <p>Votre panier est vide. Découvrez nos produits et commencez vos achats!</p>
            <hr>
            <a href="{{ path('app_products') }}" class="btn btn-primary-custom">
                Voir nos produits
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
